# Copy to .env and edit. Every variable is optional; defaults are shown.

APP_NAME=support-agent
DATA_DIR=./data              # SQLite and ChromaDB live here
DATABASE_URL=                # empty = sqlite in DATA_DIR
SEED_ON_STARTUP=true         # load sample orders and the policy document on startup

# LLM (OpenAI-compatible API; Groq free tier by default).
# Leave GROQ_API_KEY empty to run in demo mode (rule-based agent, no LLM).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.0
MAX_AGENT_STEPS=4            # max LLM turns per question

# Embeddings: sentence-transformers (local model) or hash (offline, keyword-only)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Policy retrieval
TOP_K=3
# MIN_SCORE=0.25             # unset = 0.25 for MiniLM, 0.05 for hash
